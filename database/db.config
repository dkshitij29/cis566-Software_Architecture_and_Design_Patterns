-- ========= ENUM TYPES =========

CREATE TYPE room_type_enum AS ENUM (
    'single', 
    'double', 
    'suite', 
    'deluxe', 
    'economy'
);

CREATE TYPE user_role_enum AS ENUM (
    'customer', 
    'admin', 
    'staff'
);

CREATE TYPE booking_status_enum AS ENUM (
    'pending', 
    'confirmed', 
    'canceled', 
    'completed'
);

CREATE TYPE payment_method_enum AS ENUM (
    'credit_card', 
    'paypal', 
    'bank_transfer', 
    'cash'
);

CREATE TYPE payment_status_enum AS ENUM (
    'pending', 
    'completed', 
    'failed', 
    'refunded'
);

-- ========= TABLE: users =========

CREATE TABLE users (
    user_id SERIAL PRIMARY KEY,
    firstname VARCHAR(50) NOT NULL,
    lastname VARCHAR(50) NOT NULL,
    username VARCHAR(50) NOT NULL UNIQUE,
    email VARCHAR(255) NOT NULL UNIQUE,
    phone_number VARCHAR(20) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role user_role_enum NOT NULL DEFAULT 'customer'
);
-- Note: UNIQUE constraints automatically create indexes on username, email, and phone_number.

-- ========= TABLE: rooms =========

CREATE TABLE rooms (
    room_id SERIAL PRIMARY KEY,
    room_number VARCHAR(10) NOT NULL UNIQUE,
    room_type room_type_enum NOT NULL,
    price_per_night DECIMAL(10, 2) NOT NULL CHECK (price_per_night > 0),
    is_available BOOLEAN NOT NULL DEFAULT true
);
-- Note: UNIQUE constraint automatically creates an index on room_number.

-- ========= TABLE: bookings =========

CREATE TABLE bookings (
    booking_id SERIAL PRIMARY KEY,
    user_id INT, -- Correctly allows NULL for ON DELETE SET NULL
    room_id INT NOT NULL,
    room_per_day_price DECIMAL(10, 2) NOT NULL,
    check_in_date DATE NOT NULL,
    check_out_date DATE NOT NULL,
    total_price DECIMAL(10, 2) NOT NULL,
    booking_status booking_status_enum NOT NULL DEFAULT 'pending',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,    
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id) ON DELETE RESTRICT,
    CONSTRAINT chk_booking_dates CHECK (check_out_date > check_in_date)
);

-- === PERFORMANCE INDEXES for bookings ===
-- Index for finding all bookings for a specific user
CREATE INDEX idx_bookings_user_id ON bookings(user_id);
-- This is the *most important* index. It makes your availability/conflict
-- check (find_available_rooms_for_dates) extremely fast.
CREATE INDEX idx_bookings_room_id_dates ON bookings(room_id, check_in_date, check_out_date);


-- ========= TABLE: reviews =========

CREATE TABLE reviews (
    review_id SERIAL PRIMARY KEY,
    booking_id INT NOT NULL UNIQUE,
    user_id INT, -- Should also be nullable to match bookings/users
    room_id INT, -- Should also be nullable to match rooms
    rating SMALLINT NOT NULL CHECK (rating >= 1 AND rating <= 5),
    comment TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP, 
    FOREIGN KEY (booking_id) REFERENCES bookings(booking_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL,
    FOREIGN KEY (room_id) REFERENCES rooms(room_id) ON DELETE SET NULL
);

-- === PERFORMANCE INDEXES for reviews ===
-- Index for finding all reviews for a specific room or user
CREATE INDEX idx_reviews_room_id ON reviews(room_id);
CREATE INDEX idx_reviews_user_id ON reviews(user_id);


-- ========= TABLE: payments =========

CREATE TABLE payments (
    payment_id SERIAL PRIMARY KEY,
    booking_id INT NOT NULL,
    user_id INT, -- Should also be nullable to match bookings/users
    amount DECIMAL(10, 2) NOT NULL CHECK (amount > 0),
    payment_method payment_method_enum NOT NULL,
    payment_status payment_status_enum NOT NULL DEFAULT 'pending',
    transaction_id VARCHAR(255), 
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP, 
    FOREIGN KEY (booking_id) REFERENCES bookings(booking_id) ON DELETE RESTRICT,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL
);

-- === PERFORMANCE INDEXES for payments ===
CREATE INDEX idx_payments_booking_id ON payments(booking_id);
CREATE INDEX idx_payments_user_id ON payments(user_id);


-- ========= TABLE: password_resets =========

CREATE TABLE password_resets (
    id SERIAL PRIMARY KEY,
    user_id INT NOT NULL,
    -- Store a HASH of the token, never the token itself
    token_hash TEXT NOT NULL UNIQUE,
    expires_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- Create an index for fast lookups on the token hash
CREATE INDEX idx_token_hash ON password_resets(token_hash);

-- ========= STORED PROCEDURE (TRANSACTION) =========

CREATE OR REPLACE FUNCTION process_payment_and_confirm(
    booking_id_to_confirm INT,
    user_id_for_payment INT,
    payment_amount DECIMAL,
    method payment_method_enum,
    new_transaction_id TEXT
)
RETURNS void -- 'void' means it returns nothing
LANGUAGE plpgsql
AS $$
BEGIN
    -- Step 1: Insert the payment record
    INSERT INTO payments (booking_id, user_id, amount, payment_method, transaction_id, payment_status)
    VALUES (
        booking_id_to_confirm,
        user_id_for_payment,
        payment_amount,
        method,
        new_transaction_id,
        'completed' -- Mark the payment as completed
    );

    -- Step 2: Update the booking status to 'confirmed'
    UPDATE bookings
    SET booking_status = 'confirmed'
    WHERE booking_id = booking_id_to_confirm;

-- This all happens in one transaction.
-- If the UPDATE fails, the INSERT is rolled back.
END;
$$;